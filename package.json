{
  "name": "eval-harness-skill",
  "version": "0.1.0",
  "description": "Local eval harness for agent skills and CLI workflows — fixtures, expected behaviors, scoring rubrics, and regression reports",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "eval-harness": "bin/eval-harness.js"
  },
  "files": [
    "bin",
    "dist",
    "fixtures",
    "scripts",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "bin/eval-harness.js smoke",
    "lint": "node scripts/lint.js",
    "prepack": "npm run build",
    "package:smoke": "npm pack --dry-run",
    "package:install-smoke": "node scripts/package-install-smoke.js",
    "release:check": "npm run lint && npm run check && npm test && npm run smoke && npm run package:smoke && npm run package:install-smoke"
  },
  "keywords": [
    "eval",
    "agent",
    "skill",
    "harness",
    "regression",
    "testing",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/eval-harness-skill.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.3.1"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/eval-harness-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/eval-harness-skill#readme"
}
